{
  "name": "@symbolic-ai/terminal",
  "version": "1.2.24",
  "private": true,
  "description": "Standalone Electron host for the Symbolic TUI",
  "homepage": "https://symbolic.computer",
  "license": "MIT",
  "author": {
    "name": "Symbolic",
    "email": "hello@symbolic.computer"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck": "tsgo -b",
    "lint": "oxlint src scripts electron-builder.config.ts electron.vite.config.ts vite.config.ts --deny warnings",
    "format": "oxfmt \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" electron-builder.config.ts electron.vite.config.ts vite.config.ts package.json components.json",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" electron-builder.config.ts electron.vite.config.ts vite.config.ts package.json components.json",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:runtime": "bun --cwd ../symbolic build --single --skip-install",
    "preview": "electron-vite preview",
    "ui:init": "bun ./scripts/nova.mjs",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run build && bun run smoke:dev",
    "package": "bun run build:runtime && electron-builder --config electron-builder.config.ts",
    "package:mac": "bun run build:runtime && electron-builder --mac --config electron-builder.config.ts",
    "smoke:dev": "node ./scripts/smoke.mjs dev",
    "smoke:packaged": "node ./scripts/smoke.mjs mac",
    "smoke:mac": "node ./scripts/smoke.mjs mac",
    "smoke:package": "bun run package:mac && bun run smoke:packaged",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@base-ui/react": "1.3.0",
    "@fontsource-variable/geist": "5.2.8",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "bonjour-service": "^1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron-store": "^10.1.0",
    "electron-window-state": "^5.0.3",
    "lucide-react": "0.577.0",
    "node-pty": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "4.0.8",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "catalog:",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "40.4.1",
    "electron-builder": "^26",
    "electron-vite": "^5",
    "oxfmt": "0.41.0",
    "oxlint": "1.56.0",
    "tailwindcss": "^4.2.0",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
