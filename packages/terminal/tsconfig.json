{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "emitDeclarationOnly": false,
    "outDir": "node_modules/.ts-dist",
    "paths": {
      "@/*": ["./src/renderer/*"]
    },
    "types": ["vite/client", "node", "electron"]
  },
  "include": ["src", "package.json", "electron.vite.config.ts", "electron-builder.config.ts"],
  "exclude": ["src/**/*.test.ts"]
}
