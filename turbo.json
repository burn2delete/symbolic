{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "SYMBOLIC_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "SYMBOLIC_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**", ".next/**", "out/**"]
    },
    "symbolic#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@symbolic-ai/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
